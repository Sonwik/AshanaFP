<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fast tests without a web server: domain rules, application use cases and the in-memory infrastructure.
    Run with: dotnet test tests/Ashana.UnitTests
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions as the .NET 10 SDK "xunit" project template. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ashana.Domain\Ashana.Domain.csproj" />
    <ProjectReference Include="..\..\src\Ashana.Application\Ashana.Application.csproj" />
    <ProjectReference Include="..\..\src\Ashana.Infrastructure\Ashana.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
