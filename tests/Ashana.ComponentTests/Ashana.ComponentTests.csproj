<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Component tests: Blazor components rendered in memory, without a browser.
    Markup is checked with the built-in HtmlRenderer; clicks are dispatched through a small test renderer
    (Support/TestRenderer.cs) that walks Blazor's render tree, the same way bUnit works internally.
    Run with: dotnet test tests/Ashana.ComponentTests
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions as the .NET 10 SDK "xunit" project template. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ashana.UI\Ashana.UI.csproj" />
    <ProjectReference Include="..\..\src\Ashana.Web\Ashana.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
