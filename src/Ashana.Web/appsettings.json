{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Canteen": {
    "Name": "Ashana Canteen",
    "TimeZone": "Asia/Almaty",
    "FallbackUtcOffsetHours": 5
  },
  "Storage": {
    "Provider": "File",
    "FilePath": "App_Data/ashana-data.json"
  },
  "Seed": {
    "DemoData": true,
    "HistoryDays": 14,
    "ResetOnStart": false
  },
  "Worker": {
    "Enabled": true,
    "IntervalSeconds": 30
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "ApiPerMinute": 120
  }
}
