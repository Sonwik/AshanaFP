@*
  One dish on the menu, laid out like a line on a canteen menu board: name, dotted leader, price.
  It holds no state: the page passes the quantity in the cart and receives the user's choice through callbacks.
*@
<article class="dish @(Item.IsOrderable ? null : "is-unavailable")" aria-labelledby="@_id">
    <DishTile Emoji="@Item.Emoji" ImageUrl="@Item.ImageUrl" TintKey="Item.CategoryId" />

    <div class="dish-body">
        <div class="dish-head">
            <h3 class="dish-name" id="@_id">@Item.Name</h3>
            <span class="dish-leader" aria-hidden="true"></span>
            <span class="dish-price num">@Money.Tenge(Item.Price)</span>
        </div>
        @if (!string.IsNullOrEmpty(Item.Description))
        {
            <p class="dish-desc">@Item.Description</p>
        }
        <div class="dish-meta">
            @if (!Item.IsAvailable)
            {
                <Badge Tone="Tone.Neutral">Not available today</Badge>
            }
            else if (Item.RemainingStock == 0)
            {
                <Badge Tone="Tone.Danger">Sold out</Badge>
            }
            else if (Item.IsLowStock)
            {
                <Badge Tone="Tone.Saffron">@Item.RemainingStock left</Badge>
            }
            @foreach (var (tag, text) in UiText.TagLabels(Item.Tags))
            {
                <span class="tag tag-@tag.ToString().ToLowerInvariant()">@text</span>
            }
            @if (Item.Calories is { } calories)
            {
                <span class="dish-kcal">@calories kcal</span>
            }
        </div>
    </div>

    <div class="dish-action">
        @if (Quantity > 0)
        {
            <QuantityStepper Value="Quantity" ValueChanged="QuantityChanged" Max="@Math.Min(10, Math.Max(Quantity, Item.RemainingStock))"
                             Label="@Item.Name" Compact="true" />
        }
        else
        {
            <Button Variant="ButtonVariant.Tile" Size="ButtonSize.Small" Icon="plus" Disabled="@(!Item.IsOrderable)"
                    OnClick="() => OnAdd.InvokeAsync(Item)" aria-label="@($"Add {Item.Name}")">Add</Button>
        }
    </div>
</article>

@code {
    private string _id = string.Empty;

    [Parameter, EditorRequired] public MenuItemDto Item { get; set; } = default!;

    /// <summary>How many portions of this dish are already in the cart.</summary>
    [Parameter] public int Quantity { get; set; }

    [Parameter] public EventCallback<int> QuantityChanged { get; set; }

    [Parameter] public EventCallback<MenuItemDto> OnAdd { get; set; }

    protected override void OnParametersSet() => _id = $"dish-{Item.Id:N}";
}
