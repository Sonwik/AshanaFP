@page "/account/register"
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using Ashana.Application.Users
@using Ashana.Web.Endpoints
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject AccountService Accounts
@inject NavigationManager Navigation

<PageTitle>@UiText.Title("Create an account")</PageTitle>

<h1 class="auth-title">Create an account</h1>
<p class="auth-sub">Takes a minute. Kitchen staff get their role from the canteen administrator.</p>

@if (_error is not null)
{
    <p class="form-error" role="alert"><Icon Name="circle-alert" Size="18" /> @_error</p>
}

<EditForm Model="Input" method="post" OnValidSubmit="RegisterAsync" FormName="register" class="auth-form" novalidate>
    <DataAnnotationsValidator />
    <div class="field">
        <label for="name">Your name</label>
        <InputText id="name" @bind-Value="Input.Name" autocomplete="name" />
        <ValidationMessage For="() => Input.Name" />
    </div>
    <div class="field">
        <label for="email">Email</label>
        <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="email" inputmode="email" />
        <ValidationMessage For="() => Input.Email" />
    </div>
    <div class="field">
        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" aria-describedby="password-hint" />
        <span class="field-hint" id="password-hint">At least 8 characters, with a letter and a digit.</span>
        <ValidationMessage For="() => Input.Password" />
    </div>
    <div class="field">
        <label for="confirm">Repeat password</label>
        <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" />
    </div>
    <button type="submit" class="btn-cta">Create account</button>
</EditForm>

<p class="auth-switch">Already have an account? <a href="account/login" data-enhance-nav="false">Sign in</a></p>

@code {
    private string? _error;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "register")] private RegisterInput Input { get; set; } = default!;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    // Not an initializer: on a form post the framework sets Input, otherwise we create it here (BL0008).
    protected override void OnInitialized() => Input ??= new();

    private async Task RegisterAsync()
    {
        var result = await Accounts.RegisterAsync(Input.Email, Input.Name, Input.Password, HttpContext.RequestAborted);
        if (result.IsFailure)
        {
            _error = result.Error.Message;
            return;
        }

        var principal = result.Value.ToPrincipal(CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal, new AuthenticationProperties { IsPersistent = true });
        Navigation.NavigateTo(AccountEndpoints.SafeReturnUrl(ReturnUrl), forceLoad: true);
    }
}
