@*
  Controlled "− 2 +" input. It never changes Value itself: it asks the parent through ValueChanged,
  so it works with two-way binding: <QuantityStepper @bind-Value="qty" />
*@
<div class="stepper stepper-@(Compact ? "sm" : "md")" role="group" aria-label="@($"Quantity of {Label}")">
    <button type="button" class="step" @onclick="DecreaseAsync" disabled="@(Disabled || Value <= Min)"
            aria-label="@(Value <= 1 && Min == 0 ? $"Remove {Label}" : $"One less {Label}")">
        <Icon Name="@(Value <= 1 && Min == 0 ? "trash-2" : "minus")" Size="16" />
    </button>
    <output class="value num" aria-live="polite">@Value</output>
    <button type="button" class="step" @onclick="IncreaseAsync" disabled="@(Disabled || Value >= Max)"
            aria-label="@($"One more {Label}")">
        <Icon Name="plus" Size="16" />
    </button>
</div>

@code {
    [Parameter] public int Value { get; set; }

    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    [Parameter] public int Min { get; set; }

    [Parameter] public int Max { get; set; } = 10;

    /// <summary>What is being counted, used in accessible labels ("One more Plov").</summary>
    [Parameter] public string Label { get; set; } = "item";

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool Compact { get; set; }

    private async Task DecreaseAsync()
    {
        if (Value > Min)
        {
            await ValueChanged.InvokeAsync(Value - 1);
        }
    }

    private async Task IncreaseAsync()
    {
        if (Value < Max)
        {
            await ValueChanged.InvokeAsync(Value + 1);
        }
    }
}
