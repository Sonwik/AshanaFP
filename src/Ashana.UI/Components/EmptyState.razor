@* Shown when a list is empty. It tells the user what to do next, not just "nothing here". *@
<section class="empty @Class">
    @if (Icon is not null)
    {
        <span class="empty-icon"><Icon Name="@Icon" Size="28" /></span>
    }
    @switch (HeadingLevel)
    {
        case 1:
            <h1 class="empty-title">@Title</h1>
            break;
        case 2:
            <h2 class="empty-title">@Title</h2>
            break;
        default:
            <h3 class="empty-title">@Title</h3>
            break;
    }
    @if (ChildContent is not null)
    {
        <div class="empty-text">@ChildContent</div>
    }
    @if (Actions is not null)
    {
        <div class="empty-actions">@Actions</div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Heading level of the title: 1 when the empty state is the whole page (404, no access), 3 inside a page.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;

    [Parameter] public string? Icon { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public string? Class { get; set; }
}
