@* Declares one column of a DataTable. It renders nothing itself; it registers with the parent table. *@
@typeparam TItem
@implements IDisposable

@code {
    [CascadingParameter] public DataTable<TItem>? Table { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Cell template; <c>context</c> is the row item.</summary>
    [Parameter] public RenderFragment<TItem>? ChildContent { get; set; }

    /// <summary>Makes the column sortable by this key.</summary>
    [Parameter] public Func<TItem, object?>? SortBy { get; set; }

    /// <summary>Right-align (numbers, prices, actions).</summary>
    [Parameter] public bool AlignEnd { get; set; }

    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized()
    {
        if (Table is null)
        {
            throw new InvalidOperationException("DataColumn must be placed inside a DataTable.");
        }

        Table.AddColumn(this);
    }

    public void Dispose() => Table?.RemoveColumn(this);
}
