@* Renders the toasts of ToastService. Place it once in the layout. Screen readers announce new messages. *@
@implements IDisposable
@inject ToastService Toasts

<div class="toasts" role="region" aria-label="Notifications">
    <div class="toast-stack" aria-live="polite" aria-atomic="false">
        @foreach (var toast in Toasts.Toasts)
        {
            <div @key="toast.Id" class="toast toast-@toast.Kind.ToString().ToLowerInvariant()" role="@(toast.Kind == ToastKind.Error ? "alert" : "status")">
                <Icon Name="@IconFor(toast.Kind)" Size="20" />
                <p class="toast-text">@toast.Message</p>
                <button type="button" class="toast-close" @onclick="() => Toasts.Dismiss(toast.Id)" aria-label="Dismiss">
                    <Icon Name="x" Size="16" />
                </button>
            </div>
        }
    </div>
</div>

@code {
    private readonly CancellationTokenSource _disposed = new();
    private readonly HashSet<Guid> _scheduled = [];

    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        foreach (var toast in Toasts.Toasts.Where(t => _scheduled.Add(t.Id)))
        {
            _ = DismissLaterAsync(toast);
        }

        StateHasChanged();
    });

    private async Task DismissLaterAsync(Toast toast)
    {
        try
        {
            await Task.Delay(toast.Duration, _disposed.Token);
            Toasts.Dismiss(toast.Id);
        }
        catch (TaskCanceledException)
        {
        }
        finally
        {
            _scheduled.Remove(toast.Id);
        }
    }

    private static string IconFor(ToastKind kind) => kind switch
    {
        ToastKind.Success => "circle-check-big",
        ToastKind.Warning => "triangle-alert",
        ToastKind.Error => "circle-alert",
        _ => "info",
    };

    public void Dispose()
    {
        Toasts.Changed -= OnChanged;
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
