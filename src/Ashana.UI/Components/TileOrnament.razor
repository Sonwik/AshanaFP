@*
  Repeating "koshkar muiz" (ram's horn) motif, the classic Kazakh ornament, drawn as an SVG pattern.
  Used sparingly: on the pickup ticket, the TV board and the sign-in page.
*@
<svg class="ornament @Class" width="100%" height="@Height" aria-hidden="true" focusable="false">
    <defs>
        <pattern id="@_id" width="40" height="24" patternUnits="userSpaceOnUse" patternTransform="scale(@ScaleText)">
            <path d="M20 22 C20 13 13.5 6.5 8 9.5 C3.8 11.8 5.5 17.6 9.8 16.4 C12.4 15.7 12 12.2 9.4 12.3"
                  fill="none" stroke="@Color" stroke-width="2.2" stroke-linecap="round" />
            <path d="M20 22 C20 13 26.5 6.5 32 9.5 C36.2 11.8 34.5 17.6 30.2 16.4 C27.6 15.7 28 12.2 30.6 12.3"
                  fill="none" stroke="@Color" stroke-width="2.2" stroke-linecap="round" />
            <circle cx="0" cy="4" r="1.6" fill="@Color" />
            <circle cx="40" cy="4" r="1.6" fill="@Color" />
        </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#@_id)" />
</svg>

@code {
    private readonly string _id = "orn-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public int Height { get; set; } = 28;

    /// <summary>Any CSS color, default follows the text color.</summary>
    [Parameter] public string Color { get; set; } = "currentColor";

    [Parameter] public double Scale { get; set; } = 1;

    [Parameter] public string? Class { get; set; }

    private string ScaleText => Scale.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
