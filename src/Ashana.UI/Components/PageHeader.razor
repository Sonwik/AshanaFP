@* Page title with optional back link, description and actions on the right. *@
<header class="page-header @Class">
    <div class="page-header-text">
        @if (BackHref is not null)
        {
            <a class="page-back" href="@BackHref">
                <Icon Name="arrow-left" Size="18" />
                @BackText
            </a>
        }
        <h1 class="page-title" tabindex="-1">@Title</h1>
        @if (ChildContent is not null)
        {
            <div class="page-subtitle">@ChildContent</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Text under the title.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public string? BackHref { get; set; }

    [Parameter] public string BackText { get; set; } = "Back";

    [Parameter] public string? Class { get; set; }
}
